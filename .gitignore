# ── Dart / Flutter ───────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
pubspec.lock

# Generated l10n files (regenerated by `flutter gen-l10n`)
lib/generated/

# ── Android ──────────────────────────────────────────────────────────────────
android/local.properties         # Contains flutter.sdk path (machine-specific)
android/key.properties           # NEVER commit — contains keystore credentials
android/secrets/                 # Keystore files (NEVER commit)
android/.gradle/
android/captures/
android/gradlew                  # Regenerated by flutter create; large binary
android/gradlew.bat

# ── iOS ──────────────────────────────────────────────────────────────────────
ios/Pods/
ios/.symlinks/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# ── macOS / Windows / Linux / Web ────────────────────────────────────────────
macos/Pods/
linux/flutter/
windows/flutter/
web/

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.iml

# ── Debug symbols (large; archive alongside each release build instead) ───────
build/debug-symbols/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
