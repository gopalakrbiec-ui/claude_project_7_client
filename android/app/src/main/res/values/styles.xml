<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme shown while Flutter initialises (< 200 ms on modern hardware).
         Uses a solid background matching the app's seed colour so there is no
         white flash on startup. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Applied immediately after the launch theme; Flutter takes over from here. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
